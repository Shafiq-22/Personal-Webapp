{
  "manifest_version": 3,
  "name": "Cortex Web Clipper",
  "version": "0.1.0",
  "description": "Save any page to your Cortex library, or turn it into a task, without leaving the tab.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Save to Cortex",
    "default_icon": { "128": "icons/icon.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "options_page": "src/options.html",
  "icons": { "128": "icons/icon.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current page to Cortex"
    }
  }
}
