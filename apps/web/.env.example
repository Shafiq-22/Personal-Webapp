# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and the publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Used by the API routes that act across users (feed ingestion, cron proxies).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
# An OAuth client of type "Web application". The redirect URI must be
# <NEXT_PUBLIC_SITE_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the iOS companion and the browser extension send as
# `x-cortex-client` so the API can tell first-party clients apart in logs.
# Optional; requests are still authenticated by the user's Supabase JWT.
CORTEX_CLIENT_ID=cortex-ios
